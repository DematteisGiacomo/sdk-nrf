config MCUBOOT_SIGNATURE_USING_ITS
	default y if SOC_SERIES_NRF92

config BOOT_SIGNATURE_TYPE_PURE
	default y if SOC_SERIES_NRF92 && BOOT_SIGNATURE_TYPE_ED25519

choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_ED25519 if SOC_SERIES_NRF92
endchoice

source "share/sysbuild/Kconfig"
