#include "../dts/boot_mode.dtsi"

/ {
	chosen {
		/* Same SMP UART as MCUboot serial recovery (host uses one link). */
		zephyr,uart-mcumgr = &uart132;
	};
};

&uart132 {
	status = "okay";
	memory-regions = <&cpuapp_dma_region>;
};
